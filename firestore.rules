rules_version = '2';

// =============================================================================
// BẢO MẬT SUN WORLD OPERATIONS WEB APP
// Mô hình: MẶC ĐỊNH TỪ CHỐI. Chỉ cho phép khi:
//   1. Đăng nhập Google (Firebase Auth) với email đã xác minh, VÀ
//   2. Là Super Admin (Gmail chủ sở hữu) HOẶC hồ sơ /users/{uid} đã được Admin duyệt.
// Vai trò: admin > manager > operator. User mới tự đăng ký chỉ có role 'pending'.
// NV vận hành (operator) chỉ được ghi dữ liệu của trò chơi mình phụ trách.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Hàm tiện ích ----------
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Gmail chủ sở hữu luôn có toàn quyền (không phụ thuộc dữ liệu trong DB)
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in [
        'laotuung@gmail.com',
        'laoung1996@gmail.com'
      ];
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    // Hồ sơ đã được Admin duyệt và đang hoạt động
    function isApproved() {
      return hasProfile()
        && profile().active == true
        && profile().role in ['admin', 'manager', 'operator'];
    }

    function isAdmin() {
      return isSuperAdmin() || (isApproved() && profile().role == 'admin');
    }

    function isManager() {
      return isAdmin() || (isApproved() && profile().role == 'manager');
    }

    function canRead() {
      return isSuperAdmin() || isApproved();
    }

    // NV vận hành chỉ ghi được trò chơi mình phụ trách; Manager/Admin ghi mọi trò
    function canWriteGame(gameId) {
      return isManager()
        || (isApproved() && profile().role == 'operator' && profile().assignedGame == gameId);
    }

    // ---------- 1. Hồ sơ & phân quyền người dùng ----------
    match /users/{userId} {
      // Tự đọc hồ sơ của mình (kể cả khi đang chờ duyệt); Manager/Admin đọc tất cả
      allow read: if (isSignedIn() && request.auth.uid == userId) || isManager();

      // Lần đầu đăng nhập: chỉ được tự tạo hồ sơ ở trạng thái CHỜ DUYỆT
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'pending'
        && request.resource.data.active == false
        && request.resource.data.keys().hasOnly(['email', 'name', 'photoURL', 'role', 'active', 'assignedGame', 'createdAt', 'lastLoginAt'])
      );

      // Chỉ Admin được đổi vai trò / duyệt / khóa. User chỉ được cập nhật tên, ảnh, giờ đăng nhập.
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'lastLoginAt'])
      );

      allow delete: if isAdmin();
    }

    // ---------- 2. Trạng thái trực tiếp từng trò chơi (đồng bộ từ Web App) ----------
    match /games/{gameId} {
      allow read: if canRead();
      allow create, update: if canWriteGame(gameId)
        && request.resource.data.gameId == gameId
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // ---------- 3. Ca trực vận hành ----------
    match /shifts/{shiftId} {
      allow read: if canRead();
      allow create, update: if request.resource.data.keys().hasAll(['date', 'gameId', 'gameName'])
        && canWriteGame(request.resource.data.gameId);
      allow delete: if isManager();
    }

    // ---------- 4. Thời gian dừng ----------
    match /downtimes/{downtimeId} {
      allow read: if canRead();
      allow create, update: if request.resource.data.keys().hasAll(['date', 'gameId', 'reason'])
        && canWriteGame(request.resource.data.gameId);
      allow delete: if isManager();
    }

    // ---------- 5. Chuyến / lượt chơi ----------
    match /cycles/{cycleId} {
      allow read: if canRead();
      allow create, update: if request.resource.data.keys().hasAll(['date', 'gameId', 'pax'])
        && canWriteGame(request.resource.data.gameId);
      allow delete: if isManager();
    }

    // ---------- 6. Cấu hình chung toàn khu ----------
    match /settings/{settingId} {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    // ---------- 7. Mọi đường dẫn khác: TỪ CHỐI ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

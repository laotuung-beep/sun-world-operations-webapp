rules_version = '2';

// =============================================================================
// BẢO MẬT HỆ THỐNG VẬN HÀNH MÁNG TRƯỢT (ALPINE COASTER) - SUN WORLD BA NA HILLS
// Mặc định TỪ CHỐI. Chỉ tài khoản Google đã xác minh email mới được vào.
//
// Không chia cấp (app v3): mọi Gmail đã được duyệt (users/{uid}.approved == true) đều nhập phiếu,
// duyệt phiếu, xem / chốt báo cáo. Super Admin (4 Gmail trong isSuperAdmin()) thêm quyền duyệt
// tài khoản, mở lại ngày đã chốt và cấu hình Google Sheets.
// Mỗi người tự tạo hồ sơ users/{uid} khi đăng nhập nhưng KHÔNG được tự đặt approved.
//
// Dữ liệu:
//   users/{uid}                          - hồ sơ người đăng nhập
//   days/{date}                          - ngày vận hành: số liệu đối soát + closed (đã chốt)
//   days/{date}/entries/{id}             - phiếu báo số xe của một máng trong một khung giờ
//   days/{date}/schedules/{1|2|3}        - giờ chạy của từng máng trong ngày
//   settings/app                         - URL Google Sheets dùng chung
//   daily_reports/{date}[/lines/{line}]  - APP CŨ (v2), chỉ còn để đọc lại số cũ
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    // PHẢI KHỚP với SUPER_ADMINS trong src/config.ts
    function isSuperAdmin() {
      return isGoogleUser() && request.auth.token.email.lower() in [
        'phongbanana96@gmail.com',
        'laotuung@gmail.com',
        'laoung1996@gmail.com',
        'dieuhanh.mangtruot@gmail.com'
      ];
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isApproved() {
      return isGoogleUser() && exists(myProfilePath())
        && get(myProfilePath()).data.get('approved', false) == true;
    }

    // Trường phân quyền: người dùng không tự sửa được.
    function accessKeys() {
      return ['approved', 'appRole', 'mang', 'approvedBy', 'approvedAt'];
    }

    function validAccess(d) {
      return d.get('approved', false) is bool
        && d.get('appRole', 'staff') in ['staff', 'manager']
        && (d.get('mang', null) == null || d.get('mang', null) in [1, 2, 3]);
    }

    function isValidDate(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isMember() {
      return isSuperAdmin() || isApproved();
    }

    // Ngày theo giờ Việt Nam (UTC+7) của thời điểm ghi.
    function isToday(date) {
      let p = date.split('-');
      return (request.time + duration.value(7, 'h')).date()
        == timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    function dayPath(date) {
      return /databases/$(database)/documents/days/$(date);
    }

    function isDayOpen(date) {
      return !exists(dayPath(date)) || get(dayPath(date)).data.get('closed', false) != true;
    }

    // PHẢI KHỚP với TIME_SLOTS trong src/config.ts
    function slotIds() {
      return ['0830', '1000', '1100', '1200', '1300', '1400', '1500', '1600', '1700', '1800'];
    }

    function linesOf(mang) {
      return mang == 1 ? ['line1', 'line2'] : (mang == 2 ? ['line3', 'line4'] : ['line5', 'line6']);
    }

    // PHẢI KHỚP với MAX_CARTS trong src/config.ts
    function validCount(n) {
      return n is int && n >= 0 && n <= 500;
    }

    function validLineCount(c) {
      return c is map
        && c.keys().hasOnly(['single', 'double']) && c.keys().hasAll(['single', 'double'])
        && validCount(c.single) && validCount(c.double);
    }

    function validNewEntry(date) {
      let d = request.resource.data;
      let ls = linesOf(d.mang);
      return d.keys().hasOnly(['date', 'slotId', 'mang', 'lines', 'status', 'createdBy', 'createdByName',
                               'createdByEmail', 'createdAt', 'clientCreatedAt'])
        && d.keys().hasAll(['date', 'slotId', 'mang', 'lines', 'status', 'createdBy', 'createdByName',
                            'createdAt', 'clientCreatedAt'])
        && d.date == date
        && d.slotId in slotIds()
        && d.mang in [1, 2, 3]
        && d.lines is map && d.lines.keys().hasOnly(ls) && d.lines.keys().hasAll(ls)
        && validLineCount(d.lines[ls[0]]) && validLineCount(d.lines[ls[1]])
        && d.lines[ls[0]].single + d.lines[ls[0]].double + d.lines[ls[1]].single + d.lines[ls[1]].double > 0
        && d.status in ['pending', 'approved']
        && d.createdBy == request.auth.uid
        && d.createdByName is string && d.createdByName.size() <= 100
        && d.createdAt == request.time
        && d.clientCreatedAt is int;
    }

    function validSchedule(mang) {
      let d = request.resource.data;
      let hhmm = '^(|([01][0-9]|2[0-3]):[0-5][0-9])$';
      return d.keys().hasOnly(['mang', 'openTime', 'closeTime', 'pausedMinutes', 'updatedBy', 'updatedByName', 'updatedAt'])
        && d.mang == mang
        && d.openTime is string && d.openTime.matches(hhmm)
        && d.closeTime is string && d.closeTime.matches(hhmm)
        && d.pausedMinutes is int && d.pausedMinutes >= 0 && d.pausedMinutes <= 720
        && d.updatedBy == request.auth.uid
        && d.updatedByName is string && d.updatedByName.size() <= 100
        && d.updatedAt == request.time;
    }

    function validInt(d, key, max) {
      return !(key in d) || (d[key] is int && d[key] >= 0 && d[key] <= max);
    }

    function validDay(date) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'closed', 'closedBy', 'closedByName', 'closedAt',
                               'cableCarVisitors', 'paidGateVisitors', 'freeGateVisitors', 'nightComboVisitors',
                               'counterRevenue', 'metaUpdatedBy', 'metaUpdatedByName', 'metaUpdatedAt',
                               'sheetsSyncedBy', 'sheetsSyncedAt'])
        && (!('date' in d) || d.date == date)
        && (!('closed' in d) || d.closed is bool)
        && validInt(d, 'cableCarVisitors', 1000000)
        && validInt(d, 'paidGateVisitors', 1000000)
        && validInt(d, 'freeGateVisitors', 1000000)
        && validInt(d, 'nightComboVisitors', 1000000)
        && validInt(d, 'counterRevenue', 100000000000);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Người gửi tự huỷ phiếu của mình khi còn chờ duyệt.
    function isOwnCancel() {
      return resource.data.createdBy == request.auth.uid
        && resource.data.status == 'pending'
        && changed().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time;
    }

    // Duyệt hoặc trả lại phiếu đang chờ. Không đụng tới số trên phiếu.
    function isReview() {
      let d = request.resource.data;
      return resource.data.status == 'pending'
        && d.status in ['approved', 'rejected']
        && changed().hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectReason'])
        && d.reviewedBy == request.auth.uid
        && d.reviewedByName is string && d.reviewedByName.size() <= 100
        && d.reviewedAt == request.time
        && (d.status == 'approved'
            || (d.rejectReason is string && d.rejectReason.size() > 0 && d.rejectReason.size() <= 200));
    }

    // ---------- 1. Hồ sơ người dùng ----------
    match /users/{userId} {
      allow read: if isGoogleUser() && (request.auth.uid == userId || isSuperAdmin());

      allow create: if isGoogleUser()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(accessKeys());

      allow update: if (isSuperAdmin() && validAccess(request.resource.data))
        || (isGoogleUser()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(accessKeys()));

      allow delete: if isSuperAdmin();
    }

    // ---------- 2. Ngày vận hành (app v3) ----------
    match /days/{date} {
      allow read: if isMember();

      allow create: if isMember() && isValidDate(date) && validDay(date)
        && (!('closed' in request.resource.data) || request.resource.data.closedBy == request.auth.uid);

      // Ngày đang mở: ai cũng sửa số liệu / chốt được. Ngày đã chốt: chỉ còn ghi dấu đã gửi Sheets;
      // mở lại (hoặc sửa) ngày đã chốt chỉ Super Admin.
      allow update: if isMember() && validDay(date)
        && (!changed().hasAny(['closed']) || request.resource.data.closedBy == request.auth.uid)
        && (isSuperAdmin()
            || resource.data.get('closed', false) != true
            || changed().hasOnly(['sheetsSyncedBy', 'sheetsSyncedAt']));

      // Phiếu: gửi trong ngày hôm nay, khi ngày chưa chốt. Không ai sửa được số trên phiếu.
      match /entries/{entryId} {
        allow read: if isMember();

        allow create: if isMember()
          && isValidDate(date)
          && isToday(date)
          && isDayOpen(date)
          && validNewEntry(date);

        allow update: if isMember() && isDayOpen(date) && (isOwnCancel() || isReview());
      }

      // Giờ chạy máng.
      match /schedules/{mangKey} {
        allow read: if isMember();
        allow create, update: if isMember()
          && isValidDate(date)
          && mangKey in ['1', '2', '3']
          && isDayOpen(date)
          && validSchedule(int(mangKey));
      }
    }

    // ---------- 3. Cấu hình dùng chung ----------
    match /settings/app {
      allow read: if isMember();
      allow write: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['sheetsWebhookUrl', 'updatedBy', 'updatedAt'])
        && request.resource.data.sheetsWebhookUrl is string
        && request.resource.data.sheetsWebhookUrl.size() <= 500;
    }

    // ---------- 4. APP CŨ (v2): báo cáo ngày + số liệu từng line ----------
    // Giữ để đọc lại số cũ. Xoá khi không còn cần.
    function isLegacyStaff() {
      return isSuperAdmin() || isApproved();
    }

    match /daily_reports/{date} {
      allow read: if isLegacyStaff();
      allow create, update: if isLegacyStaff() && isValidDate(date);
      allow delete: if isSuperAdmin();

      match /lines/{lineId} {
        allow read: if isLegacyStaff();
        allow create, update: if isLegacyStaff()
          && isValidDate(date)
          && lineId in ['line1', 'line2', 'line3', 'line4', 'line5', 'line6']
          && request.resource.data.lineId == lineId
          && request.resource.data.date == date;
        allow delete: if isSuperAdmin();
      }
    }

    // ---------- 5. Mọi đường dẫn khác: TỪ CHỐI ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

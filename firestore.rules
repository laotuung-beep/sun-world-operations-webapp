rules_version = '2';

// =============================================================================
// BẢO MẬT HỆ THỐNG VẬN HÀNH MÁNG TRƯỢT (ALPINE COASTER) - SUN WORLD BA NA HILLS
// Mô hình: MẶC ĐỊNH TỪ CHỐI. Chỉ cho phép khi:
//   1. Đăng nhập bằng Google (Gmail) với email đã xác minh, VÀ
//   2. Là Super Admin (danh sách bên dưới) HOẶC hồ sơ users/{uid} có approved == true.
// App tự ghi hồ sơ users/{uid} khi đăng nhập nhưng KHÔNG được tự đặt "approved".
// Duyệt nhân viên: Firebase Console > Firestore > users > {uid} > thêm field
//   approved (boolean) = true. Khóa: đổi thành false.
//
// Dữ liệu của app:
//   users/{uid}                          - hồ sơ người đăng nhập
//   daily_reports/{YYYY-MM-DD}           - thông số chung của ngày
//   daily_reports/{date}/lines/{lineId}  - số xe theo từng line (line1..line6)
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    // PHẢI KHỚP với danh sách Super Admin trong app (public/assets/index-mangtruot-v2.js)
    function isSuperAdmin() {
      return isGoogleUser() && request.auth.token.email.lower() in [
        'phongbanana96@gmail.com',
        'laotuung@gmail.com',
        'laoung1996@gmail.com',
        'dieuhanh.mangtruot@gmail.com'
      ];
    }

    function isApproved() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isGoogleUser() && exists(path) && get(path).data.get('approved', false) == true;
    }

    function isStaff() {
      return isSuperAdmin() || isApproved();
    }

    function isValidDate(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- 1. Hồ sơ người dùng ----------
    match /users/{userId} {
      allow read: if isGoogleUser() && (request.auth.uid == userId || isSuperAdmin());

      // Tự tạo / cập nhật hồ sơ của mình, nhưng không được đụng tới "approved"
      allow create: if isGoogleUser()
        && request.auth.uid == userId
        && !('approved' in request.resource.data);
      allow update: if isSuperAdmin() || (
        isGoogleUser()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved'])
      );
      allow delete: if isSuperAdmin();
    }

    // ---------- 2. Báo cáo ngày ----------
    match /daily_reports/{date} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isValidDate(date);
      allow delete: if isSuperAdmin();

      // ---------- 3. Số liệu từng line ----------
      match /lines/{lineId} {
        allow read: if isStaff();
        allow create, update: if isStaff()
          && isValidDate(date)
          && lineId in ['line1', 'line2', 'line3', 'line4', 'line5', 'line6']
          && request.resource.data.lineId == lineId
          && request.resource.data.date == date;
        allow delete: if isSuperAdmin();
      }
    }

    // ---------- 4. Mọi đường dẫn khác: TỪ CHỐI ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
